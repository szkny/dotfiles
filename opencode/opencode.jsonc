{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1",
      },
      "models": {
        "qwen3:4b-32k": {
          "name": "Qwen3 4B 32K",
          "limit": {
            "context": 32768,
            "output": 4096,
          },
        },
        "qwen3:4b-16k": {
          "name": "Qwen3 4B 16K",
          "limit": {
            "context": 16384,
            "output": 4096,
          },
        },
        "qwen3:4b-8k": {
          "name": "Qwen3 4B 8K",
          "limit": {
            "context": 8192,
            "output": 4096,
          },
        },
        "lukaspetrik/gemma3-tools:4b": {
          "name": "Gemma3 Tools 4B",
          "limit": {
            "context": 4096,
            "output": 4096,
          },
        },
      },
    },
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
    },
  },
}