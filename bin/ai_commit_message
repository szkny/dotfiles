#!/usr/bin/env bash

set -euo pipefail

diff="$(git diff --cached)"

if [[ -z "$diff" ]]; then
    echo "No staged changes."
    exit 1
fi

echo "Generating commit message..."

response="$(
    jq -n --arg diff "$diff" '
    {
      model: "gpt-5-nano",
      input: [
        {
          role: "system",
          content: "You generate concise Git commit messages."
        },
        {
          role: "user",
          content: (
            "Generate a single-line Git commit message for the following staged diff.\n\n" +

            "Use this exact format:\n" +
            "<type>: <emoji> <description>\n\n" +

            "Allowed types and emojis:\n" +
            "feat = 🎸 New feature\n" +
            "fix = 🐛 Bug fix\n" +
            "docs = ✏️ Documentation\n" +
            "style = 💄 Code style or formatting\n" +
            "refactor = 💡 Refactoring\n" +
            "perf = ⚡️ Performance improvement\n" +
            "test = 💍 Tests\n" +
            "ci = 🎡 CI/CD related changes\n" +
            "chore = 🤖 Build process or auxiliary tool changes\n\n" +

            "Rules:\n" +
            "- Do not use a scope. Never write feat(scope): or fix(scope):.\n" +
            "- Choose exactly one type from the allowed types.\n" +
            "- Use the corresponding emoji.\n" +
            "- Write a concise description in English.\n" +
            "- Use imperative mood.\n" +
            "- Output only the commit message.\n" +
            "- Do not add a period at the end.\n" +
            "- No explanation.\n" +
            "- No markdown.\n\n" +

            "Examples:\n" +
            "feat: 🎸 add user authentication\n" +
            "fix: 🐛 handle null API response\n" +
            "refactor: 💡 simplify configuration loading\n\n" +

            "Diff:\n" +
            $diff
          )
        }
      ]
    }
    ' |
    curl -sS https://api.openai.com/v1/responses \
        -H "Authorization: Bearer $OPENAI_API_KEY" \
        -H "Content-Type: application/json" \
        -d @-
)"

if echo "$response" | jq -e '.error' >/dev/null 2>&1; then
    echo "$response" | jq -r '.error.message'
    exit 1
fi

message="$(
    echo "$response" |
    jq -r '
      .output[]
      | select(.type == "message")
      | .content[]
      | select(.type == "output_text")
      | .text
    ' |
    head -n 1
)"

if [[ -z "$message" || "$message" == "null" ]]; then
    echo "Failed to generate commit message."
    exit 1
fi

# 改行を除去
message="$(printf '%s' "$message" | tr '\n' ' ' | sed 's/[[:space:]]*$//')"

echo
echo "========================================"
echo "Commit message:"
echo
echo "  $message"
echo
echo "========================================"
echo

read -r -p "Commit this change? [Y/n] " answer

case "$answer" in
    ""|y|Y|yes|YES)
        git commit -m "$message"
        ;;
    *)
        echo "Commit cancelled."
        exit 0
        ;;
esac

